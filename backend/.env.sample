# ==============================================================================
# Atelier — AI Tutor Platform: backend environment
#
#   cp .env.sample .env      then fill in the blanks (NVIDIA_API_KEY at minimum).
#
# Every variable below is defined in app/config.py, and the values shown are the
# real code defaults — so a copy of this file with NVIDIA_API_KEY filled in boots.
# Secrets are intentionally left blank. NEVER commit .env.
# ==============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development                   # development | staging | production
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
JSON_LOGS=false                       # false = pretty console; true in production

# ── JWT auth ──────────────────────────────────────────────────────────────────
# SECRET_KEY must be changed for production — startup raises if it still contains
# "change-this" while APP_ENV=production.
SECRET_KEY=change-this-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── NVIDIA NIM (REQUIRED) ─────────────────────────────────────────────────────
# Every Strands agent runs on NIM's OpenAI-compatible endpoint. Without a key the
# chat, quiz, course and interview flows all fail. Key: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=qwen/qwen3-next-80b-a3b-instruct
NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# The orchestrator routes each chat turn; specialists run the per-domain agent
# loops. Do NOT swap the orchestrator to mistralai/mistral-nemotron — it can't
# reliably invoke the structured-output tool that routing depends on.
NIM_ORCHESTRATOR_MODEL=qwen/qwen3-next-80b-a3b-instruct
NIM_SPECIALIST_MODEL=qwen/qwen3-next-80b-a3b-instruct
NIM_RPM_LIMIT=40                      # NVIDIA free-tier requests/minute (token bucket)

# ── Agent chat memory ─────────────────────────────────────────────────────────
# Empty AGENT_SESSIONS_DIR → OS temp dir. Fine for a single instance; point at a
# durable/shared volume for multi-instance production.
AGENT_SESSIONS_DIR=
CHAT_MEMORY_WINDOW=40                 # messages kept in context per chat thread

# ── Live module interview ─────────────────────────────────────────────────────
INTERVIEW_MAX_QUESTIONS=8             # hard cap — force-conclude after this many
INTERVIEW_MIN_QUESTIONS=4             # minimum asked before the agent may conclude

# ── Quiz ──────────────────────────────────────────────────────────────────────
QUIZ_SECONDS_PER_QUESTION=60          # per-question timer, served to the client

# ── Hugging Face ──────────────────────────────────────────────────────────────
# Used for heavy generation (Together / NVIDIA inference providers).
# Get a token at https://huggingface.co/settings/tokens
HF_TOKEN=

# ── MongoDB (the datastore: users, sessions, progress, evals) ────────────────
MONGO_URL=mongodb://localhost:27017   # Atlas: mongodb+srv://user:pass@cluster/
MONGO_DATABASE=ai_tutor_evals

# ── Quality evals (DeepEval; the judge reuses the NVIDIA NIM creds above) ────
EVAL_JUDGE_MODEL=qwen/qwen3-next-80b-a3b-instruct
EVAL_THRESHOLD=0.6                    # default pass threshold per metric
EVALS_ONLINE_SAMPLING=true            # master switch for random online sampling
EVAL_MAX_CONCURRENCY=2                # max simultaneous judge calls
EVAL_MAX_PENDING=16                   # drop new sampling past this queue depth
EVAL_JUDGE_MAX_RETRIES=4              # handles NVIDIA 429s with backoff
EVAL_JUDGE_TIMEOUT_S=30.0

# ── Evals dashboard superuser (the only account that can view evals) ─────────
# Both must be set or nothing is seeded — there are no source defaults, by design.
# Set them and the account's password is re-synced from here on every boot.
# Example: SUPERUSER_EMAIL=you@example.com
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# ── Code checking (interview compiler) ────────────────────────────────────────
# Set to a Piston service for real sandboxed execution (60+ languages). Empty means
# the submission is reviewed by an LLM instead. There is no local-execution fallback:
# running learner code in the API container was an RCE hole. Don't add one back.
# Example: PISTON_BASE_URL=http://piston:2000
PISTON_BASE_URL=
CODE_RUN_TIMEOUT_MS=10000

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

# ── Redis / Celery (background tasks: progress digests, trend discovery) ─────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Request activity logging (middleware → MongoDB) ─────────────────────────
ACTIVITY_LOGGING_ENABLED=true

# ── Email (password reset, notifications) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Atelier AI Tutor <noreply@atelier.ai>
APP_BASE_URL=http://localhost:5173    # used to build links in outgoing email

# ── Langfuse tracing (leave both keys empty to disable) ─────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── OpenTelemetry (leave the endpoint empty to disable OTLP export) ─────────
# Example: OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-tutor
OTEL_ENABLED=true

# ── Resilience tunables (app/resilience.py) ─────────────────────────────────
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_S=1.0
RETRY_MAX_DELAY_S=16.0
CB_FAILURE_THRESHOLD=5                # circuit opens after N failures in CB_WINDOW_S
CB_WINDOW_S=60.0
CB_RECOVERY_S=30.0
